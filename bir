                <rect x="62" y="160" width="76" height="30" rx="6" fill="#ffffff" stroke="#e2e8f0" stroke-width="1"/>
                <path d="M 62 168 Q 71 174 80 168 Q 89 174 98 168 Q 107 174 116 168 Q 125 174 138 168 L 138 160 L 62 160 Z" fill="#f43f5e" opacity="0.8"/>
                <rect x="76" y="145" width="4" height="15" fill="#38bdf8" />
                <path d="M 78 136 Q 81 141 78 145 Q 75 141 78 136 Z" fill="#f59e0b" />
                <rect x="98" y="141" width="4" height="19" fill="#a855f7" />
                <path d="M 100 131 Q 103 136 100 141 Q 97 136 100 131 Z" fill="#f59e0b" />
                <rect x="120" y="145" width="4" height="15" fill="#34d399" />
                <path d="M 122 136 Q 125 141 122 145 Q 119 141 122 136 Z" fill="#f59e0b" />
            </svg>
        </div>

        <h2>Preparing a special surprise...</h2>
        <div class="timer-badge">Opening in <span id="p1-timer">5</span>s ✨</div>
    </div>

    <!-- PAGE 2: SPECIAL LETTER -->
    <div id="page2" class="card">
        <div class="letter-sheet">
            <h3>💌 A Special Letter ✍️</h3>
            <p class="letter-text">
                Dear Ravina,

                Wishing you a day filled with laughter, love, and infinite joy. May this new year bring you closer to all your dreams!

                Happy Birthday! 🎂
            </p>
        </div>

        <h2>Turning to the final page...</h2>
        <div class="timer-badge">Please wait <span id="p2-timer">5</span>s 🚀</div>
    </div>

    <!-- PAGE 3: CLOSING CELEBRATION CARD -->
    <div id="page3" class="card">
        <div class="celebration-box">
            <div class="crown-icon">👑</div>
            <h2 class="ravina-title">Happy Birthday, Ravina!</h2>
            <p style="font-size: 1.1rem; font-weight: 600; color: #4b5563;">✨ May your day be as bright and beautiful as your smile! ✨</p>
        </div>

        <button onclick="restartExperience()" style="width: 100%;">View From Beginning 🔄</button>
    </div>

    <!-- Live Transition Timer Engine Script -->
    <script>
        let countdownTimer;

        function initExperience() {
            clearInterval(countdownTimer);
            
            document.querySelectorAll('.card').forEach(c => c.classList.remove('active-view'));
            document.getElementById('page1').classList.add('active-view');
            
            startPageCountdown('page1', 'page2', 'p1-timer');
        }

        function startPageCountdown(currentId, nextId, displayId) {
            let secondsLeft = 5;
            const displayElement = document.getElementById(displayId);
            if (displayElement) displayElement.innerText = secondsLeft;

            countdownTimer = setInterval(() => {
                secondsLeft--;
                if (displayElement) displayElement.innerText = secondsLeft;

                if (secondsLeft <= 0) {
                    clearInterval(countdownTimer);
                    switchPage(currentId, nextId);
                    
                    if (nextId === 'page2') {
                        setTimeout(() => {
