<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Ravina! 🎉</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #fbcfe8 0%, #e9d5ff 40%, #bae6fd 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow-x: hidden;
        }
        
        .card {
            width: 100%;
            max-width: 400px;
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 24px;
            padding: 35px 24px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            
            /* High-Performance Visual Transitions */
            transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            opacity: 0;
            transform: scale(0.92) translateY(20px);
            display: none;
        }

        /* Fully Visible State Class */
        .card.active-view {
            display: block !important;
            opacity: 1 !important;
            transform: scale(1) translateY(0px) !important;
        }

        h2 {
            color: #4c1d95;
            font-size: 1.35rem;
            margin-top: 15px;
            font-weight: 700;
            line-height: 1.4;
        }

        .timer-badge {
            display: inline-block;
            margin-top: 20px;
            background: rgba(76, 29, 149, 0.12);
            color: #4c1d95;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 20px;
            letter-spacing: 0.5px;
        }

        .letter-sheet {
            background: #f4ebd0;
            color: #4a3b32;
            border-left: 8px solid #dcd1b4;
            border-radius: 16px;
            padding: 25px;
            text-align: left;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.05), 0 10px 20px rgba(0,0,0,0.1);
            margin-bottom: 10px;
        }
        .letter-sheet h3 {
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #7c6353;
            border-bottom: 1px solid #dcd1b4;
            padding-bottom: 8px;
            margin-bottom: 15px;
        }
        .letter-text {
            font-size: 1.25rem;
            line-height: 1.6;
            font-style: italic;
        }
        
        .celebration-box {
            background: #f4ebd0;
            color: #4a3b32;
            border-top: 8px solid #dcd1b4;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }
        .crown-icon {
            font-size: 3.5rem;
            margin-bottom: 10px;
            animation: bounce 2s infinite;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .ravina-title {
            font-size: 2.2rem;
            color: #db2777;
            margin: 15px 0;
            font-weight: 900;
            letter-spacing: 1px;
        }
        .gold-text {
            font-weight: 900;
            font-size: 20px;
            fill: url(#goldGradient);
            filter: drop-shadow(0px 3px 4px rgba(0,0,0,0.25));
            letter-spacing: 4px;
        }
        button {
            padding: 12px 30px;
            font-size: 1rem;
            font-weight: bold;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            background: linear-gradient(to right, #10b981, #059669);
            color: white;
            transition: transform 0.1s ease;
        }
        button:active {
            transform: scale(0.95);
        }
    </style>
</head>
<body>

    <!-- PAGE 1: TEDDY BEAR & CAKE -->
